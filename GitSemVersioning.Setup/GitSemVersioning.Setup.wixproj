<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>GitSemVersioning</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressValidation>true</SuppressValidation>
    <DefaultCompressionLevel>none</DefaultCompressionLevel>
    <PublishDir>$(MSBuildProjectDirectory)\..\artifact\publish\</PublishDir>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <Target Name="PublishDesktopApp" BeforeTargets="CoreCompile">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\GitSemVersioning\GitSemVersioning.csproj&quot; --configuration $(Configuration) --runtime win-x64 --self-contained true --output &quot;$(PublishDir)&quot;" />
  </Target>
</Project>